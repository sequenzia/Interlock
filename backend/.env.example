# Copy to backend/.env and fill in. backend/.env is gitignored.
TYPESAFE_API_KEY=
# Only for interlock baseline, the chat-LLM comparison. A key that is not scoped
# to a workspace also needs the workspace id, sent as the anthropic-workspace-id header:
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# Only when the console runs on another origin, for example the Vercel deployment:
# CONSOLE_ORIGINS=https://interlock-demo.vercel.app
